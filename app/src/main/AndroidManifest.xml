<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One-time model pull from the Qualcomm AI Hub asset bucket. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the 3 GB pull alive when the screen locks in the field. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Evidence capture for the vision model. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- §5.4 — a proof-of-delivery certificate records where the handover
         happened. Coarse is enough to place a dock; fine is requested so a
         dispute can distinguish two gates on the same site. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.VeriTransit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tamper voice notes: shared to Telegram / supervisor chat. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
