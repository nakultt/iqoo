<?xml version="1.0" encoding="utf-8"?>
<!--
  The pilot backend runs on a laptop on the dock LAN with no certificate
  (db/README.md calls this out). Cleartext is therefore permitted for local
  addresses only — every other host still requires TLS, so a mis-typed public
  URL fails loudly instead of silently sending scan evidence in the clear.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Private ranges: dock Wi-Fi and Tailscale. -->
        <domain includeSubdomains="true">172.26.252.224</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">nakuls-macbook-pro.tail97d9c7.ts.net</domain>
    </domain-config>
</network-security-config>
