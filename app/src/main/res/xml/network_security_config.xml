<?xml version="1.0" encoding="utf-8"?>
<!--
  The OpenRouter leg is HTTPS-only and stays under the platform default
  (cleartext refused). The one sanctioned exception is loopback: the web
  dashboard (`:dashboard`) reached over `adb reverse tcp:8080 tcp:8080`, where
  127.0.0.1:8080 on the handset tunnels to the host machine over USB.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
